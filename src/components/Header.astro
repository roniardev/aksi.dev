---
---

<header
  class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md"
>
  <div class="max-w-[980px] mx-auto px-6 flex h-14 items-center justify-between text-sm">
    <a
      href="/"
      class="font-bold text-black hover:text-black/60 transition-colors"
      aria-label="Homepage"
    >
      aksi.dev
    </a>

    <nav class="hidden md:flex items-center gap-6">
      <a
        href="/catalog"
        class="text-black/60 hover:text-black transition-colors"
      >
        Catalog
      </a>
      <a
        href="/products"
        class="text-black/60 hover:text-black transition-colors"
      >
        Products
      </a>
      <a
        href="/about"
        class="text-black/60 hover:text-black transition-colors"
      >
        About
      </a>
      <a
        href="/contact"
        class="text-black/60 hover:text-black transition-colors"
      >
        Contact
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      class="md:hidden p-2 text-black"
      aria-label="Toggle menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-md">
    <nav class="max-w-[980px] mx-auto px-6 py-4 flex flex-col gap-2">
      <a
        href="/catalog"
        class="text-sm text-black/60 hover:text-black py-2"
      >
        Catalog
      </a>
      <a
        href="/products"
        class="text-sm text-black/60 hover:text-black py-2"
      >
        Products
      </a>
      <a
        href="/about"
        class="text-sm text-black/60 hover:text-black py-2"
      >
        About
      </a>
      <a
        href="/contact"
        class="text-sm text-black/60 hover:text-black py-2"
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
