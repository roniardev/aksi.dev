---
import BaseLayout from "@/layouts/BaseLayout.astro";

const productCategories = [
  {
    title: "Business Printing",
    description: "Professional essentials for your brand",
    image: "https://images.unsplash.com/photo-1554224311-beee4ece0933?w=800&h=600&fit=crop"
  },
  {
    title: "Large Format",
    description: "Big, bold, and beautiful",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop"
  },
  {
    title: "Marketing Materials",
    description: "Drive engagement and results",
    image: "https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=800&h=600&fit=crop"
  },
  {
    title: "Signage",
    description: "Guide, inform, and impress",
    image: "https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=800&h=600&fit=crop"
  },
  {
    title: "Events & Trade Shows",
    description: "Stand out from the crowd",
    image: "https://images.unsplash.com/photo-1475721027785-f74eccf877e2?w=800&h=600&fit=crop"
  },
  {
    title: "Promotional",
    description: "Branded products that last",
    image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&h=600&fit=crop"
  }
];
---

<BaseLayout
  title="Products - Akselerasi"
  description="Discover our full range of printing and graphics products"
>
  <!-- Hero Section -->
  <section class="pt-20 pb-16 md:pt-28 md:pb-24 bg-amber-50">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h1 class="page-title text-5xl md:text-7xl font-semibold mb-4 tracking-tight">
        Products
      </h1>
      <p class="page-subtitle text-xl md:text-2xl text-black/60">
        Everything you need to make your mark.
      </p>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="pb-20 md:pb-32 bg-white">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {productCategories.map((category, index) => (
          <div class="product-item group">
            <div class="aspect-[4/3] overflow-hidden bg-neutral-100 rounded-2xl mb-6">
              <img
                src={category.image}
                alt={category.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <h3 class="text-3xl md:text-4xl font-semibold mb-3">
              {category.title}
            </h3>
            <p class="text-xl text-black/60 mb-4">
              {category.description}
            </p>
            <a
              href="/catalog"
              class="text-yellow-600 hover:text-yellow-700 hover:underline text-lg font-medium"
            >
              Explore {category.title.toLowerCase()} →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20 md:py-32 bg-green-50">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="features-title text-4xl md:text-5xl font-semibold mb-16 text-center tracking-tight">
        Why choose us.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="feature-item text-center">
          <h3 class="text-2xl font-semibold mb-3">Premium Quality</h3>
          <p class="text-lg text-black/60">
            State-of-the-art technology meets exceptional materials.
          </p>
        </div>
        <div class="feature-item text-center">
          <h3 class="text-2xl font-semibold mb-3">Fast Turnaround</h3>
          <p class="text-lg text-black/60">
            Quick production without compromising quality.
          </p>
        </div>
        <div class="feature-item text-center">
          <h3 class="text-2xl font-semibold mb-3">Expert Support</h3>
          <p class="text-lg text-black/60">
            Professional guidance every step of the way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-32 bg-white">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h2 class="cta-title text-4xl md:text-5xl font-semibold mb-6 tracking-tight">
        Let's create something amazing.
      </h2>
      <p class="cta-subtitle text-xl md:text-2xl text-black/60 mb-10">
        Get started today.
      </p>
      <div class="cta-buttons flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/catalog"
          class="inline-block bg-yellow-400 hover:bg-yellow-500 text-black px-6 py-3 rounded-lg text-base font-medium transition-colors"
        >
          Browse catalog
        </a>
        <a
          href="/contact"
          class="inline-block text-yellow-600 hover:text-yellow-700 hover:underline px-6 py-3 text-base font-medium"
        >
          Contact us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Page title animation
  gsap.from(".page-title", {
    opacity: 0,
    y: 30,
    duration: 1,
    delay: 0.2,
    ease: "power3.out"
  });

  gsap.from(".page-subtitle", {
    opacity: 0,
    y: 20,
    duration: 1,
    delay: 0.4,
    ease: "power3.out"
  });

  // Product items stagger
  gsap.from(".product-item", {
    scrollTrigger: {
      trigger: ".product-item",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 40,
    stagger: 0.2,
    duration: 1,
    ease: "power3.out"
  });

  // Features
  gsap.from(".features-title", {
    scrollTrigger: {
      trigger: ".features-title",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 30,
    duration: 1,
    ease: "power3.out"
  });

  gsap.from(".feature-item", {
    scrollTrigger: {
      trigger: ".feature-item",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 30,
    stagger: 0.15,
    duration: 1,
    ease: "power3.out"
  });

  // CTA
  gsap.from(".cta-title", {
    scrollTrigger: {
      trigger: ".cta-title",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 30,
    duration: 1,
    ease: "power3.out"
  });

  gsap.from(".cta-subtitle", {
    scrollTrigger: {
      trigger: ".cta-subtitle",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 20,
    duration: 1,
    delay: 0.2,
    ease: "power3.out"
  });

  gsap.from(".cta-buttons", {
    scrollTrigger: {
      trigger: ".cta-buttons",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 20,
    duration: 1,
    delay: 0.3,
    ease: "power3.out"
  });
</script>
