---
import BaseLayout from "@/layouts/BaseLayout.astro";

const productCategories = [
  {
    title: "Business Printing",
    description: "Professional essentials for your brand",
    image: "https://images.unsplash.com/photo-1554224311-beee4ece0933?w=800&h=600&fit=crop"
  },
  {
    title: "Large Format",
    description: "Big, bold, and beautiful",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop"
  },
  {
    title: "Marketing Materials",
    description: "Drive engagement and results",
    image: "https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=800&h=600&fit=crop"
  },
  {
    title: "Signage",
    description: "Guide, inform, and impress",
    image: "https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=800&h=600&fit=crop"
  }
];
---

<BaseLayout
  title="Products - Akselerasi"
  description="Discover our full range of printing and graphics products"
>
  <!-- Hero Section -->
  <section class="pt-24 pb-12 md:pt-32 md:pb-16 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <h1 class="page-title text-4xl md:text-6xl font-bold mb-4 tracking-tight">
        Products
      </h1>
      <p class="page-subtitle text-lg md:text-xl text-black/60">
        Everything you need to make your mark.
      </p>
    </div>
  </section>

  <!-- Products List -->
  <section class="pb-16 md:pb-20 bg-white">
    <div class="max-w-[980px] mx-auto px-6 space-y-12">
      {productCategories.map((category) => (
        <div class="product-item">
          <h2 class="text-2xl md:text-3xl font-bold mb-2 tracking-tight">
            {category.title}
          </h2>
          <p class="text-base md:text-lg text-black/60 mb-6">
            {category.description}
          </p>
          <div class="aspect-[16/10] overflow-hidden bg-neutral-50 rounded-lg">
            <img
              src={category.image}
              alt={category.title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="cta-title text-2xl md:text-3xl font-bold mb-4 tracking-tight">
        Let's create something amazing
      </h2>
      <p class="cta-subtitle text-base md:text-lg text-black/60 mb-6">
        Get started today.
      </p>
      <div class="cta-buttons flex gap-4">
        <a
          href="/catalog"
          class="inline-block bg-black hover:bg-black/80 text-white px-5 py-2.5 rounded-md text-sm font-medium transition-colors"
        >
          View catalog
        </a>
        <a
          href="/contact"
          class="inline-block border border-black/20 hover:border-black/40 text-black px-5 py-2.5 rounded-md text-sm font-medium transition-colors"
        >
          Contact us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";

  // Simple fade-in on page load
  gsap.from(".page-title", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.1,
    ease: "power2.out"
  });

  gsap.from(".page-subtitle", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.2,
    ease: "power2.out"
  });
</script>
