---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact - Akselerasi"
  description="Get in touch with us"
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-20 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <h1 class="page-title text-4xl md:text-6xl font-bold mb-4 tracking-tight">
        Contact
      </h1>
      <p class="page-subtitle text-lg md:text-xl text-black/60">
        We'd love to hear from you.
      </p>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="pb-20 md:pb-32 bg-white border-t border-black/5">
    <div class="max-w-[640px] mx-auto px-6">
      <form class="contact-form space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="first-name" class="block text-sm font-medium text-black mb-2">
              First name
            </label>
            <input
              type="text"
              id="first-name"
              name="first-name"
              class="w-full px-3 py-2 border border-neutral-300 rounded-md focus:ring-2 focus:ring-black focus:border-transparent outline-none transition-all text-sm"
              required
            />
          </div>
          <div>
            <label for="last-name" class="block text-sm font-medium text-black mb-2">
              Last name
            </label>
            <input
              type="text"
              id="last-name"
              name="last-name"
              class="w-full px-3 py-2 border border-neutral-300 rounded-md focus:ring-2 focus:ring-black focus:border-transparent outline-none transition-all text-sm"
              required
            />
          </div>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-black mb-2">
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            class="w-full px-3 py-2 border border-neutral-300 rounded-md focus:ring-2 focus:ring-black focus:border-transparent outline-none transition-all text-sm"
            required
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-black mb-2">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="6"
            class="w-full px-3 py-2 border border-neutral-300 rounded-md focus:ring-2 focus:ring-black focus:border-transparent outline-none transition-all resize-none text-sm"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-black hover:bg-black/80 text-white px-5 py-2.5 rounded-md text-sm font-medium transition-colors"
        >
          Send message
        </button>
      </form>
    </div>
  </section>

  <!-- Contact Info Section -->
  <section class="py-20 md:py-32 bg-white border-t border-black/5">
    <div class="max-w-[640px] mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-bold mb-8 tracking-tight">
        Or reach us directly
      </h2>
      <div class="space-y-4">
        <div>
          <div class="text-sm font-semibold mb-1">Email</div>
          <a href="mailto:info@aksi.dev" class="text-sm text-black/60 hover:text-black">
            info@aksi.dev
          </a>
        </div>
        <div>
          <div class="text-sm font-semibold mb-1">Phone</div>
          <a href="tel:+15551234567" class="text-sm text-black/60 hover:text-black">
            +1 (555) 123-4567
          </a>
        </div>
        <div>
          <div class="text-sm font-semibold mb-1">Location</div>
          <p class="text-sm text-black/60">
            123 Main Street, City, State 12345
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";

  // Simple fade-in on page load
  gsap.from(".page-title", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.1,
    ease: "power2.out"
  });

  gsap.from(".page-subtitle", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.2,
    ease: "power2.out"
  });
</script>
