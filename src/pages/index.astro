---
import { buttonVariants } from "@/components/ui/button";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Akselerasi"
  description="Akselerasi"
>
  <section
    class="container px-4 mx-auto grid items-center gap-6 pt-6 pb-8 md:py-10"
  >
    <div class="flex flex-col gap-4 border-2 border-foreground p-6 bg-card">
      <pre class="text-sm leading-tight">
┌─────────────────────────────┐
│    SYSTEM INITIALIZING...   │
└─────────────────────────────┘
      </pre>
      <p class="text-lg font-bold uppercase tracking-wider">
        &gt; Coming soon...
      </p>
      <p class="text-muted-foreground text-sm">
        [ PRESS ANY KEY TO CONTINUE ]
      </p>
    </div>
  </section>
</BaseLayout>
