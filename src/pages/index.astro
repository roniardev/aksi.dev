---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Akselerasi"
  description="Professional printing and graphics solutions"
>
  <!-- Hero Section -->
  <section class="relative bg-white text-black pt-32 pb-20 md:pt-40 md:pb-24">
    <div class="max-w-[980px] mx-auto px-6">
      <h1 class="hero-title text-4xl md:text-6xl font-bold mb-6 tracking-tight">
        Professional printing and graphics solutions.
      </h1>
      <p class="hero-description text-lg md:text-xl text-black/60 mb-8 max-w-[600px]">
        We love quality, precision, and helping businesses make an impact.
      </p>
      <div class="hero-buttons flex gap-4">
        <a
          href="/catalog"
          class="inline-block bg-black hover:bg-black/80 text-white px-5 py-2.5 rounded-md text-sm font-medium transition-colors"
        >
          View catalog
        </a>
        <a
          href="/contact"
          class="inline-block border border-black/20 hover:border-black/40 text-black px-5 py-2.5 rounded-md text-sm font-medium transition-colors"
        >
          Contact
        </a>
      </div>
    </div>
  </section>

  <!-- Feature Section 1 -->
  <section class="py-20 md:py-32 bg-white border-t border-black/5">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="feature-title text-3xl md:text-4xl font-bold mb-3 tracking-tight">
        Business Printing
      </h2>
      <p class="feature-subtitle text-base md:text-lg text-black/60 mb-8">
        Cards that leave an impression.
      </p>
      <div class="feature-image aspect-[16/10] rounded-lg overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=1400&h=800&fit=crop"
          alt="Business cards"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Feature Section 2 -->
  <section class="py-20 md:py-32 bg-white border-t border-black/5">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="feature-title text-3xl md:text-4xl font-bold mb-3 tracking-tight">
        Large Format
      </h2>
      <p class="feature-subtitle text-base md:text-lg text-black/60 mb-8">
        From banners to vehicle wraps.
      </p>
      <div class="feature-image aspect-[16/10] rounded-lg overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1400&h=800&fit=crop"
          alt="Large format printing"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Feature Section 3 -->
  <section class="py-20 md:py-32 bg-white border-t border-black/5">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="feature-title text-3xl md:text-4xl font-bold mb-3 tracking-tight">
        Marketing Materials
      </h2>
      <p class="feature-subtitle text-base md:text-lg text-black/60 mb-8">
        Brochures, flyers, and promotional materials.
      </p>
      <div class="feature-image aspect-[16/10] rounded-lg overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1586281380349-632531db7ed4?w=1400&h=800&fit=crop"
          alt="Marketing materials"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 md:py-32 bg-white border-t border-black/5">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="services-title text-2xl md:text-3xl font-bold mb-12 tracking-tight">
        What we do
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="service-item">
          <h3 class="text-lg font-semibold mb-2">Signage</h3>
          <p class="text-sm text-black/60">
            Indoor and outdoor solutions.
          </p>
        </div>
        <div class="service-item">
          <h3 class="text-lg font-semibold mb-2">Events</h3>
          <p class="text-sm text-black/60">
            Trade show displays.
          </p>
        </div>
        <div class="service-item">
          <h3 class="text-lg font-semibold mb-2">Promotional</h3>
          <p class="text-sm text-black/60">
            Branded products.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-32 bg-white border-t border-black/5">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="cta-title text-2xl md:text-3xl font-bold mb-4 tracking-tight">
        Get started
      </h2>
      <p class="cta-subtitle text-base md:text-lg text-black/60 mb-8">
        Ready to bring your vision to life?
      </p>
      <div class="cta-buttons flex gap-4">
        <a
          href="/contact"
          class="inline-block bg-black hover:bg-black/80 text-white px-5 py-2.5 rounded-md text-sm font-medium transition-colors"
        >
          Contact us
        </a>
        <a
          href="/catalog"
          class="inline-block border border-black/20 hover:border-black/40 text-black px-5 py-2.5 rounded-md text-sm font-medium transition-colors"
        >
          View catalog
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";

  // Simple fade-in animation on page load
  gsap.from(".hero-title", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.1,
    ease: "power2.out"
  });

  gsap.from(".hero-description", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.2,
    ease: "power2.out"
  });

  gsap.from(".hero-buttons", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.3,
    ease: "power2.out"
  });
</script>
