---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Akselerasi"
  description="Professional printing and graphics solutions"
>
  <!-- Hero Section -->
  <section class="relative bg-black text-white pt-16 pb-24 md:pt-20 md:pb-32">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-7xl font-semibold mb-4 tracking-tight">
        Akselerasi
      </h1>
      <p class="text-2xl md:text-3xl font-semibold mb-2">
        Think different. Print better.
      </p>
      <p class="text-xl md:text-2xl text-white/80 mb-8">
        Professional printing redefined.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <a
          href="/catalog"
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full text-base font-normal transition-colors"
        >
          Browse catalog
        </a>
        <a
          href="/contact"
          class="inline-block border-2 border-blue-600 hover:bg-blue-600 text-white px-6 py-3 rounded-full text-base font-normal transition-colors"
        >
          Get started
        </a>
      </div>
    </div>
    <div class="w-full aspect-[16/9] max-w-[1200px] mx-auto px-6">
      <img
        src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=1400&h=800&fit=crop"
        alt="Professional workspace"
        class="w-full h-full object-cover rounded-2xl"
        loading="eager"
      />
    </div>
  </section>

  <!-- Feature Section 1 -->
  <section class="py-20 md:py-32 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-5xl md:text-6xl font-semibold mb-4 tracking-tight">
          Business Printing
        </h2>
        <p class="text-xl md:text-2xl text-black/60">
          Cards that leave an impression.
        </p>
      </div>
      <div class="aspect-[16/10] rounded-2xl overflow-hidden mb-8">
        <img
          src="https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=1400&h=800&fit=crop"
          alt="Business cards"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="text-center">
        <a href="/products" class="text-blue-600 hover:underline text-lg">
          Learn more →
        </a>
      </div>
    </div>
  </section>

  <!-- Feature Section 2 -->
  <section class="py-20 md:py-32 bg-neutral-50">
    <div class="max-w-[980px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1">
          <h2 class="text-4xl md:text-5xl font-semibold mb-4 tracking-tight">
            Large Format
          </h2>
          <p class="text-xl md:text-2xl text-black/60 mb-6">
            Go big. Make an impact.
          </p>
          <p class="text-lg text-black/70 mb-8">
            From banners to vehicle wraps, we bring your vision to life in stunning detail.
          </p>
          <a href="/products" class="text-blue-600 hover:underline text-lg">
            Explore large format →
          </a>
        </div>
        <div class="order-1 md:order-2 aspect-square rounded-2xl overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&h=800&fit=crop"
            alt="Large format printing"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Section 3 -->
  <section class="py-20 md:py-32 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="aspect-square rounded-2xl overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1586281380349-632531db7ed4?w=800&h=800&fit=crop"
            alt="Marketing materials"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <h2 class="text-4xl md:text-5xl font-semibold mb-4 tracking-tight">
            Marketing Materials
          </h2>
          <p class="text-xl md:text-2xl text-black/60 mb-6">
            Designed to convert.
          </p>
          <p class="text-lg text-black/70 mb-8">
            Brochures, flyers, and promotional materials that drive results for your business.
          </p>
          <a href="/products" class="text-blue-600 hover:underline text-lg">
            View marketing solutions →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 md:py-32 bg-neutral-50">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-semibold mb-16 text-center tracking-tight">
        Everything you need.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="text-center">
          <h3 class="text-2xl font-semibold mb-3">Signage</h3>
          <p class="text-lg text-black/60">
            Indoor and outdoor solutions that guide and inform.
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-2xl font-semibold mb-3">Events</h3>
          <p class="text-lg text-black/60">
            Trade show displays that demand attention.
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-2xl font-semibold mb-3">Promotional</h3>
          <p class="text-lg text-black/60">
            Branded products that keep you top of mind.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-32 bg-white">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-semibold mb-6 tracking-tight">
        Ready to get started?
      </h2>
      <p class="text-xl md:text-2xl text-black/60 mb-10">
        Let's bring your vision to life.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full text-base font-normal transition-colors"
        >
          Contact us
        </a>
        <a
          href="/catalog"
          class="inline-block text-blue-600 hover:underline px-6 py-3 text-base font-normal"
        >
          Browse catalog
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
