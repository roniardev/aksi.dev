---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="About - Akselerasi"
  description="Learn more about our company and our commitment"
>
  <!-- Hero Section -->
  <section class="pt-20 pb-16 md:pt-28 md:pb-24 bg-white">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-7xl font-semibold mb-4 tracking-tight">
        About Akselerasi
      </h1>
      <p class="text-xl md:text-2xl text-black/60">
        Quality printing. Exceptional service.
      </p>
    </div>
  </section>

  <!-- Story Section -->
  <section class="pb-20 md:pb-32 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center mb-24">
        <div>
          <h2 class="text-4xl md:text-5xl font-semibold mb-6 tracking-tight">
            Our story
          </h2>
          <p class="text-xl text-black/60 leading-relaxed">
            Founded with a passion for exceptional quality and customer service, we've been serving businesses and individuals with premium printing and graphics solutions.
          </p>
        </div>
        <div class="aspect-square rounded-2xl overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=800&h=800&fit=crop"
            alt="About us"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div class="aspect-square rounded-2xl overflow-hidden order-2 md:order-1">
          <img
            src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=800&h=800&fit=crop"
            alt="Our approach"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="order-1 md:order-2">
          <h2 class="text-4xl md:text-5xl font-semibold mb-6 tracking-tight">
            Our approach
          </h2>
          <p class="text-xl text-black/60 leading-relaxed">
            We combine state-of-the-art technology with traditional craftsmanship. From concept to completion, we're committed to bringing your vision to life.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-20 md:py-32 bg-neutral-50">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-semibold mb-16 text-center tracking-tight">
        Our values
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="text-center">
          <h3 class="text-2xl font-semibold mb-3">Quality First</h3>
          <p class="text-lg text-black/60">
            We never compromise. Every project receives our full attention and commitment.
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-2xl font-semibold mb-3">Customer Focus</h3>
          <p class="text-lg text-black/60">
            Your satisfaction drives everything we do. We listen and deliver.
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-2xl font-semibold mb-3">Innovation</h3>
          <p class="text-lg text-black/60">
            We stay ahead with new technologies and techniques.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-20 md:py-32 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-5xl md:text-6xl font-semibold mb-2">25+</div>
          <div class="text-lg text-black/60">Years</div>
        </div>
        <div class="text-center">
          <div class="text-5xl md:text-6xl font-semibold mb-2">10k+</div>
          <div class="text-lg text-black/60">Projects</div>
        </div>
        <div class="text-center">
          <div class="text-5xl md:text-6xl font-semibold mb-2">500+</div>
          <div class="text-lg text-black/60">Clients</div>
        </div>
        <div class="text-center">
          <div class="text-5xl md:text-6xl font-semibold mb-2">99%</div>
          <div class="text-lg text-black/60">Satisfaction</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-32 bg-neutral-50">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-semibold mb-6 tracking-tight">
        Let's work together.
      </h2>
      <p class="text-xl md:text-2xl text-black/60 mb-10">
        Ready to get started?
      </p>
      <a
        href="/contact"
        class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full text-base font-normal transition-colors"
      >
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>
