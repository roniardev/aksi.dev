---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="About - Akselerasi"
  description="Learn more about our company and our commitment"
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-20 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <h1 class="page-title text-4xl md:text-6xl font-bold mb-4 tracking-tight">
        About
      </h1>
      <p class="page-subtitle text-lg md:text-xl text-black/60 max-w-[600px]">
        We love quality printing, precision design, and helping businesses make an impact.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="pb-20 md:pb-32 bg-white border-t border-black/5">
    <div class="max-w-[980px] mx-auto px-6 space-y-12">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold mb-3 tracking-tight">
          Our story
        </h2>
        <p class="text-base md:text-lg text-black/60 leading-relaxed">
          Founded with a passion for exceptional quality and customer service, we've been serving businesses with premium printing and graphics solutions.
        </p>
      </div>

      <div>
        <h2 class="text-2xl md:text-3xl font-bold mb-3 tracking-tight">
          What we do
        </h2>
        <p class="text-base md:text-lg text-black/60 leading-relaxed mb-6">
          We combine state-of-the-art technology with traditional craftsmanship. From concept to completion, we're committed to bringing your vision to life.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <h3 class="text-base font-semibold mb-2">Quality First</h3>
            <p class="text-sm text-black/60">
              We never compromise on quality.
            </p>
          </div>
          <div>
            <h3 class="text-base font-semibold mb-2">Customer Focus</h3>
            <p class="text-sm text-black/60">
              Your satisfaction drives us.
            </p>
          </div>
          <div>
            <h3 class="text-base font-semibold mb-2">Innovation</h3>
            <p class="text-sm text-black/60">
              We stay ahead with new tech.
            </p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl md:text-3xl font-bold mb-6 tracking-tight">
          By the numbers
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div>
            <div class="text-3xl md:text-4xl font-bold mb-1">25+</div>
            <div class="text-sm text-black/60">Years</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-bold mb-1">10k+</div>
            <div class="text-sm text-black/60">Projects</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-bold mb-1">500+</div>
            <div class="text-sm text-black/60">Clients</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-bold mb-1">99%</div>
            <div class="text-sm text-black/60">Satisfaction</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-32 bg-white border-t border-black/5">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-bold mb-4 tracking-tight">
        Let's work together
      </h2>
      <p class="text-base md:text-lg text-black/60 mb-6">
        Ready to get started?
      </p>
      <a
        href="/contact"
        class="inline-block bg-black hover:bg-black/80 text-white px-5 py-2.5 rounded-md text-sm font-medium transition-colors"
      >
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";

  // Simple fade-in on page load
  gsap.from(".page-title", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.1,
    ease: "power2.out"
  });

  gsap.from(".page-subtitle", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.2,
    ease: "power2.out"
  });
</script>
