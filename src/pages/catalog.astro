---
import BaseLayout from "@/layouts/BaseLayout.astro";

const catalogItems = [
  {
    id: 1,
    title: "Business Cards",
    category: "Print",
    image: "https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=600&h=600&fit=crop",
    description: "Premium quality cards"
  },
  {
    id: 2,
    title: "Banners",
    category: "Large Format",
    image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=600&fit=crop",
    description: "Eye-catching displays"
  },
  {
    id: 3,
    title: "Brochures",
    category: "Marketing",
    image: "https://images.unsplash.com/photo-1586281380349-632531db7ed4?w=600&h=600&fit=crop",
    description: "Professional materials"
  },
  {
    id: 4,
    title: "Signage",
    category: "Signage",
    image: "https://images.unsplash.com/photo-1508615263227-e1e8b88136d4?w=600&h=600&fit=crop",
    description: "Custom solutions"
  },
  {
    id: 5,
    title: "Vehicle Graphics",
    category: "Large Format",
    image: "https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?w=600&h=600&fit=crop",
    description: "Mobile advertising"
  },
  {
    id: 6,
    title: "Flyers",
    category: "Marketing",
    image: "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=600&h=600&fit=crop",
    description: "Effective campaigns"
  }
];
---

<BaseLayout
  title="Catalog - Akselerasi"
  description="Browse our comprehensive catalog"
>
  <!-- Hero Section -->
  <section class="pt-24 pb-12 md:pt-32 md:pb-16 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <h1 class="page-title text-4xl md:text-6xl font-bold mb-4 tracking-tight">
        Catalog
      </h1>
      <p class="page-subtitle text-lg md:text-xl text-black/60">
        Explore our complete range.
      </p>
    </div>
  </section>

  <!-- Catalog Grid -->
  <section class="pb-16 md:pb-20 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {catalogItems.map((item, index) => (
          <a href="/products" class="catalog-item group block">
            <div class="aspect-[4/3] overflow-hidden bg-neutral-50 rounded-lg mb-3">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover group-hover:opacity-90 transition-opacity duration-300"
                loading="lazy"
              />
            </div>
            <p class="text-xs text-black/40 mb-1">
              {item.category}
            </p>
            <h3 class="text-lg font-semibold mb-1">
              {item.title}
            </h3>
            <p class="text-sm text-black/60">
              {item.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-[980px] mx-auto px-6">
      <h2 class="cta-title text-2xl md:text-3xl font-bold mb-4 tracking-tight">
        Need something custom?
      </h2>
      <p class="cta-subtitle text-base md:text-lg text-black/60 mb-6">
        We're here to help.
      </p>
      <a
        href="/contact"
        class="cta-button inline-block bg-black hover:bg-black/80 text-white px-5 py-2.5 rounded-md text-sm font-medium transition-colors"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";

  // Simple fade-in on page load
  gsap.from(".page-title", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.1,
    ease: "power2.out"
  });

  gsap.from(".page-subtitle", {
    opacity: 0,
    y: 10,
    duration: 0.6,
    delay: 0.2,
    ease: "power2.out"
  });
</script>
