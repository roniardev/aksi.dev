---
import BaseLayout from "@/layouts/BaseLayout.astro";

const catalogItems = [
  {
    id: 1,
    title: "Business Cards",
    category: "Print",
    image: "https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=600&h=600&fit=crop",
    description: "Premium quality cards"
  },
  {
    id: 2,
    title: "Banners",
    category: "Large Format",
    image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=600&fit=crop",
    description: "Eye-catching displays"
  },
  {
    id: 3,
    title: "Brochures",
    category: "Marketing",
    image: "https://images.unsplash.com/photo-1586281380349-632531db7ed4?w=600&h=600&fit=crop",
    description: "Professional materials"
  },
  {
    id: 4,
    title: "Signage",
    category: "Signage",
    image: "https://images.unsplash.com/photo-1508615263227-e1e8b88136d4?w=600&h=600&fit=crop",
    description: "Custom solutions"
  },
  {
    id: 5,
    title: "Vehicle Graphics",
    category: "Large Format",
    image: "https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?w=600&h=600&fit=crop",
    description: "Mobile advertising"
  },
  {
    id: 6,
    title: "Flyers",
    category: "Marketing",
    image: "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=600&h=600&fit=crop",
    description: "Effective campaigns"
  }
];
---

<BaseLayout
  title="Catalog - Akselerasi"
  description="Browse our comprehensive catalog"
>
  <!-- Hero Section -->
  <section class="pt-20 pb-16 md:pt-28 md:pb-24 bg-white">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-7xl font-semibold mb-4 tracking-tight">
        Catalog
      </h1>
      <p class="text-xl md:text-2xl text-black/60">
        Explore our complete range of solutions.
      </p>
    </div>
  </section>

  <!-- Catalog Grid -->
  <section class="pb-20 md:pb-32 bg-white">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {catalogItems.map((item) => (
          <div class="group">
            <div class="aspect-square overflow-hidden bg-neutral-100 rounded-2xl mb-4">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <p class="text-sm text-orange-600 mb-1">
              {item.category}
            </p>
            <h3 class="text-2xl font-semibold mb-2">
              {item.title}
            </h3>
            <p class="text-lg text-black/60 mb-3">
              {item.description}
            </p>
            <a
              href={`/products`}
              class="text-blue-600 hover:underline inline-flex items-center"
            >
              Learn more →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-32 bg-neutral-50">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-semibold mb-6 tracking-tight">
        Need something custom?
      </h2>
      <p class="text-xl md:text-2xl text-black/60 mb-10">
        We're here to help.
      </p>
      <a
        href="/contact"
        class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full text-base font-normal transition-colors"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
