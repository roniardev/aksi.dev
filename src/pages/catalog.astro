---
import BaseLayout from "@/layouts/BaseLayout.astro";

const catalogItems = [
  {
    id: 1,
    title: "Business Cards",
    category: "Print",
    image: "https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=600&h=600&fit=crop",
    description: "Premium quality cards"
  },
  {
    id: 2,
    title: "Banners",
    category: "Large Format",
    image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=600&fit=crop",
    description: "Eye-catching displays"
  },
  {
    id: 3,
    title: "Brochures",
    category: "Marketing",
    image: "https://images.unsplash.com/photo-1586281380349-632531db7ed4?w=600&h=600&fit=crop",
    description: "Professional materials"
  },
  {
    id: 4,
    title: "Signage",
    category: "Signage",
    image: "https://images.unsplash.com/photo-1508615263227-e1e8b88136d4?w=600&h=600&fit=crop",
    description: "Custom solutions"
  },
  {
    id: 5,
    title: "Vehicle Graphics",
    category: "Large Format",
    image: "https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?w=600&h=600&fit=crop",
    description: "Mobile advertising"
  },
  {
    id: 6,
    title: "Flyers",
    category: "Marketing",
    image: "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=600&h=600&fit=crop",
    description: "Effective campaigns"
  }
];
---

<BaseLayout
  title="Catalog - Akselerasi"
  description="Browse our comprehensive catalog"
>
  <!-- Hero Section -->
  <section class="pt-20 pb-16 md:pt-28 md:pb-24 bg-blue-50">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h1 class="page-title text-5xl md:text-7xl font-semibold mb-4 tracking-tight">
        Catalog
      </h1>
      <p class="page-subtitle text-xl md:text-2xl text-black/60">
        Explore our complete range of solutions.
      </p>
    </div>
  </section>

  <!-- Catalog Grid -->
  <section class="pb-20 md:pb-32 bg-white">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {catalogItems.map((item, index) => (
          <div class="catalog-item group">
            <div class="aspect-square overflow-hidden bg-neutral-100 rounded-2xl mb-4">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <p class="text-sm text-black/50 mb-1">
              {item.category}
            </p>
            <h3 class="text-2xl font-semibold mb-2">
              {item.title}
            </h3>
            <p class="text-lg text-black/60 mb-3">
              {item.description}
            </p>
            <a
              href={`/products`}
              class="text-yellow-600 hover:text-yellow-700 hover:underline inline-flex items-center font-medium"
            >
              Learn more →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-32 bg-white">
    <div class="max-w-[980px] mx-auto px-6 text-center">
      <h2 class="cta-title text-4xl md:text-5xl font-semibold mb-6 tracking-tight">
        Need something custom?
      </h2>
      <p class="cta-subtitle text-xl md:text-2xl text-black/60 mb-10">
        We're here to help.
      </p>
      <a
        href="/contact"
        class="cta-button inline-block bg-yellow-400 hover:bg-yellow-500 text-black px-6 py-3 rounded-lg text-base font-medium transition-colors"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Page title animation
  gsap.from(".page-title", {
    opacity: 0,
    y: 30,
    duration: 1,
    delay: 0.2,
    ease: "power3.out"
  });

  gsap.from(".page-subtitle", {
    opacity: 0,
    y: 20,
    duration: 1,
    delay: 0.4,
    ease: "power3.out"
  });

  // Catalog items stagger animation
  gsap.from(".catalog-item", {
    scrollTrigger: {
      trigger: ".catalog-item",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 40,
    stagger: 0.15,
    duration: 1,
    ease: "power3.out"
  });

  // CTA section
  gsap.from(".cta-title", {
    scrollTrigger: {
      trigger: ".cta-title",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 30,
    duration: 1,
    ease: "power3.out"
  });

  gsap.from(".cta-subtitle", {
    scrollTrigger: {
      trigger: ".cta-subtitle",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 20,
    duration: 1,
    delay: 0.2,
    ease: "power3.out"
  });

  gsap.from(".cta-button", {
    scrollTrigger: {
      trigger: ".cta-button",
      start: "top 80%",
      toggleActions: "play none none reverse"
    },
    opacity: 0,
    y: 20,
    duration: 1,
    delay: 0.3,
    ease: "power3.out"
  });
</script>
