---
import { buttonVariants } from "@/components/ui/button";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 - Not Found"
  description="404 Error — this page was not found"
>
  <div class="mt-32 flex flex-col items-center justify-center px-8 gap-6">
    <div class="border-2 border-destructive p-8 bg-card max-w-2xl w-full">
      <pre class="text-destructive text-sm leading-tight mb-4">
╔═══════════════════════════════╗
║     SYSTEM ERROR DETECTED     ║
╚═══════════════════════════════╝
      </pre>
      <p class="text-destructive text-sm font-bold uppercase mb-2">ERROR CODE: 404</p>
      <h1 class="text-3xl font-bold tracking-tight uppercase mb-4">
        &gt; PAGE NOT FOUND
      </h1>
      <p class="mb-6 text-sm text-muted-foreground">
        &gt; THE REQUESTED RESOURCE COULD NOT BE LOCATED IN THE SYSTEM DATABASE.
      </p>
      <a href="/" rel="noreferrer" class={buttonVariants()}> [ RETURN TO HOME ] </a>
    </div>
  </div>
</BaseLayout>
